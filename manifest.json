{
    "manifest_version": 3,
    "name": "Proxy Manager",
    "version": "1.2.0",
    "description": "Прокси в один клик: скрывает реальный IP, защищает от утечек через WebRTC и следит, чтобы прокси действительно работал",
    "minimum_chrome_version": "108",
    "permissions": ["proxy", "storage", "declarativeNetRequest", "webRequest", "webRequestAuthProvider", "privacy"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Proxy Manager",
        "default_icon": {
            "16": "icons/icon16-off.png",
            "32": "icons/icon32-off.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "commands": {
        "toggle-proxy": {
            "suggested_key": {
                "default": "Alt+Shift+P"
            },
            "description": "Включить или выключить прокси"
        }
    }
}
